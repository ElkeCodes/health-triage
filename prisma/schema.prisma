generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Triage {
  id               Int      @id @default(autoincrement())
  age              Int
  gender           String
  symptoms         String[] @default([])
  urgency          String
  pathway          String
  next             String
  consultationType String
  createdAt        DateTime @default(now())
}
